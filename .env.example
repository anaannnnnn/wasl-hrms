# Copy to .env (project root for Docker, or server/.env for running with Node directly)
NODE_ENV=development
PORT=4000
# Local Node run uses this; Docker Compose overrides it to the mongo container
MONGO_URI=mongodb://localhost:27017/wasl_hrms
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
CORS_ORIGIN=*
SERVE_WEB=true

# ---- Document storage (Linode Object Storage, S3-compatible) ----
# STORAGE_DRIVER=local stores files on disk (development only)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_ENDPOINT=https://<region>.linodeobjects.com
# S3_REGION=<region>
# S3_BUCKET=wasl-documents
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- AI (document OCR, receipts, AI agent). Optional: everything has a manual fallback ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Notifications. Optional: in-app notifications always work ----
# RESEND_API_KEY=
# MAIL_FROM=Wasl HR <hr@yourdomain.ae>
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ---- Background jobs (expiry alerts 90/60/30/7 days, Emiratisation). Set false on extra instances ----
JOBS_ENABLED=true
