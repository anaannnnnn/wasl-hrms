# Copy to .env (project root for Docker, or server/.env for running with Node directly)
NODE_ENV=development
PORT=4000
# Local Node run uses this; Docker Compose overrides it to the mongo container
MONGO_URI=mongodb://localhost:27017/wasl_hrms
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
CORS_ORIGIN=*
SERVE_WEB=true
